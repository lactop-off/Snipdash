# Snipdash container app mode. Copy this file to `.env` and adjust.
# Read by docker-compose and passed to the container entrypoint.
#
#   development = Vite dev server with hot reload (default)
#   production  = production build served by `vite preview`
#   manual      = do not auto-start the app; keep the container alive for a shell
#
# In any mode the UI is published on http://localhost:1420 and you can open a
# shell with: docker compose exec dev bash
APP_MODE=development
